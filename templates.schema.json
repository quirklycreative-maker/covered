{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "covered/templates.schema.json",
  "title": "Covered country pack: templates.yaml",
  "type": "object",
  "required": ["pack", "ejagriti_bundle", "field_catalog", "templates"],
  "properties": {
    "pack": {"type": "object", "required": ["id", "version", "status", "languages", "hindi_review"]},
    "ejagriti_bundle": {
      "type": "array", "minItems": 7,
      "items": {"type": "object", "required": ["upload", "template"], "properties": {"upload": {"type": "string"}, "template": {"type": ["string", "null"]}}}
    },
    "field_catalog": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["en", "hi", "kind"],
        "properties": {"en": {"type": "string"}, "hi": {"type": "string"}, "kind": {"enum": ["text", "date", "number", "derived"]}},
        "additionalProperties": false
      }
    },
    "templates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "note", "rules", "body"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"$ref": "#/$defs/text"},
          "note": {"$ref": "#/$defs/text"},
          "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "slots": {
            "type": "object",
            "additionalProperties": {
              "type": "object", "required": ["when", "options"],
              "properties": {
                "when": {"type": "string"},
                "multi": {"type": "boolean"},
                "options": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/text_ext"}}
              },
              "additionalProperties": false
            }
          },
          "form_map": {
            "type": "array",
            "items": {"type": "object", "required": ["field", "required"], "properties": {"field": {"type": "string"}, "from": {"type": "array", "items": {"type": "string"}}, "choose": {"type": "string"}, "note": {"type": "string"}, "required": {"type": "boolean"}}, "additionalProperties": false}
          },
          "body": {"$ref": "#/$defs/text"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "text": {"type": "object", "required": ["en", "hi"], "properties": {"en": {"type": "string", "minLength": 1}, "hi": {"type": "string", "minLength": 1}}},
    "text_ext": {"type": "object", "required": ["en", "hi"], "properties": {"en": {"type": "string", "minLength": 1}, "hi": {"type": "string", "minLength": 1}, "clause": {"type": "string"}}, "additionalProperties": false}
  }
}
